# =========================
# SmartDocQ Backend Config
# =========================

# Flask / JWT secret
# Generate a new value; do not reuse the old one.
SECRET_KEY="PASTE_NEW_SECRET_KEY_HERE"

# Google Gemini API key
# Create a NEW key after revoking the exposed one.
GOOGLE_API_KEY="PASTE_NEW_GOOGLE_API_KEY_HERE"

# Google OAuth Client ID
VITE_GOOGLE_CLIENT_ID="628796585681-fnbptscfp7j4todfb95p3o792kuul6pi.apps.googleusercontent.com"

# Local development database
DATABASE_URL="sqlite:///./smartdocq.db"

# AI configuration
AI_ENABLED=true

# Enable testing behavior when Gemini rate limits are reached
TESTING_MODE_ON_RATE_LIMIT=true

# Gemini model configuration
MODEL_NAME=gemini-pro
TEMPERATURE=0.7
